# Web UI
DASHBOARD_PORT=8765
DASHBOARD_ADMIN_PASSWORD=change-me-please

# Collect intervals, seconds
STATUS_INTERVAL=30
SURGE_INTERVAL=5

# Optional: Emby API integration for latest media posters.
# Keep token in .env only; never put it in config.json.
EMBY_API_KEY=
EMBY_USER_ID=

# Optional: Surge External Controller token
SURGE_API_TOKEN=

# Optional: UniFi / UBNT readonly account
UBNT_USERNAME=
UBNT_PASSWORD=

# Optional media mount for Docker fallback poster scan
MEDIA_PATH=./media
